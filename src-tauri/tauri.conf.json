{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Octauri",
  "version": "1.0.3",
  "identifier": "io.github.nbsod.octauri",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Octauri",
        "width": 820,
        "height": 560,
        "minWidth": 680,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/openconnect/": "openconnect/",
      "infoplist/zh-Hans.lproj/": "zh-Hans.lproj/"
    },
    "shortDescription": "OpenConnect 图形客户端",
    "longDescription": "openconnect 命令行的图形外壳，提供多配置管理、一键连接、实时日志与托盘控制。不包含任何 VPN 协议实现。",
    "copyright": "Copyright © 2025 Octauri Contributors. GPL-3.0-or-later. Octauri name and logo are trademarks of the project.",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
